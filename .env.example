# Copy to .env to override defaults. All settings are optional.
SHOPSTREAM_DATA_DIR=data
SHOPSTREAM_TRANSPORT=file            # file | kafka
SHOPSTREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SHOPSTREAM_KAFKA_TOPIC=shopstream.events
SHOPSTREAM_BATCH_MAX_MESSAGES=5000
SHOPSTREAM_MAX_DEAD_LETTER_RATIO=0.05
# SHOPSTREAM_MAX_FRESHNESS_HOURS=24  # enable when running against live (non-simulated-history) data
