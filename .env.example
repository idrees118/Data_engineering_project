# Copy to .env to override defaults. All settings are optional.
SHOPSTREAM_DATA_DIR=data
SHOPSTREAM_TRANSPORT=file            # file | kafka
SHOPSTREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SHOPSTREAM_KAFKA_TOPIC=shopstream.events
SHOPSTREAM_BATCH_MAX_MESSAGES=5000
SHOPSTREAM_MAX_DEAD_LETTER_RATIO=0.05
# SHOPSTREAM_MAX_FRESHNESS_HOURS=24  # enable when running against live (non-simulated-history) data

# Object storage (leave unset to keep the lake on local disk). For MinIO set the endpoint too.
# SHOPSTREAM_LAKE_URI=s3://shopstream-lake/bronze
# SHOPSTREAM_S3_ENDPOINT_URL=http://localhost:9000   # used by Python
# SHOPSTREAM_S3_ENDPOINT=localhost:9000              # used by dbt (host:port, no scheme)
# SHOPSTREAM_S3_ACCESS_KEY_ID=minioadmin
# SHOPSTREAM_S3_SECRET_ACCESS_KEY=minioadmin
# SHOPSTREAM_S3_USE_SSL=false
# SHOPSTREAM_S3_URL_STYLE=path

# Bronze compaction: only partitions idle for this long are merged.
# SHOPSTREAM_COMPACTION_MIN_AGE_SECONDS=3600
